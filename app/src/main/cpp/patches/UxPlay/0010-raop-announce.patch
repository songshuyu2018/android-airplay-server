+                               (double) reply_time / SECOND_IN_NSECS, str);
+                    free(str);
+                }
+                continue;   /* that was a request, not the reply we were waiting for */
+            }
             if (response_len < 0) {
                 char time[30];
                 ntp_timestamp_to_time(send_time, time, sizeof(time));
@@ -387,7 +424,13 @@ raop_ntp_thread(void *arg)
         struct timespec wait_time;
         MUTEX_LOCK(raop_ntp->wait_mutex);
         clock_gettime(CLOCK_REALTIME, &wait_time);
-        wait_time.tv_sec += 3;
+        /* Poll often: as an NTP server we must answer senders promptly, and a
