diff --git a/lib/raop_handlers.h b/lib/raop_handlers.h
index 5037e68..2c6ee4c 100644
--- a/lib/raop_handlers.h
+++ b/lib/raop_handlers.h
@@ -590,7 +590,56 @@ raop_handler_options(raop_conn_t *conn,
                      http_request_t *request, http_response_t *response,
                      char **response_data, int *response_datalen)
 {
-    http_response_add_header(response, "Public", "SETUP, RECORD, FLUSH, TEARDOWN, OPTIONS, GET_PARAMETER, SET_PARAMETER");
+    http_response_add_header(response, "Public", "ANNOUNCE, SETUP, RECORD, FLUSH, TEARDOWN, OPTIONS, GET_PARAMETER, SET_PARAMETER");
+}
+
+/*
+ * RAOP (AirPlay 1) ANNOUNCE: the sender declares its audio format (SDP) before
+ * SETUP. This build only implemented the AirPlay 2 plist SETUP flow, so RAOP
+ * senders (Music Assistant, shairport-based tools, ...) used to get 501 here.
+ *
+ * Only unencrypted ALAC streams are accepted: the AES key in an ANNOUNCE is
+ * RSA-encrypted with the receiver's RSA public key, and this build publishes an
+ * Ed25519 key (for HAP pairing) instead, so it cannot decrypt it.
+ */
+static void
+raop_handler_announce(raop_conn_t *conn,
+                      http_request_t *request, http_response_t *response,
+                      char **response_data, int *response_datalen)
+{
+    raop_t *raop = conn->raop;
+    const char *data = NULL;
+    int data_len = 0;
+
+    data = http_request_get_data(request, &data_len);
+    if (!data || data_len <= 0) {
+        logger_log(raop->logger, LOGGER_ERR, "ANNOUNCE without an SDP body");
+        http_response_init(response, "RTSP/1.0", 400, "Bad Request");
+        return;
+    }
+
+    bool alac = (strstr(data, "AppleLossless") != NULL);
+    bool encrypted = (strstr(data, "rsaaeskey:") != NULL);
+
+    logger_log(raop->logger, LOGGER_INFO, "ANNOUNCE: codec=%s audio-encryption=%s",
+               alac ? "ALAC" : "unsupported", encrypted ? "rsa(aes)" : "none");
+
+    if (!alac) {
+        logger_log(raop->logger, LOGGER_ERR,
+                   "ANNOUNCE requested an unsupported codec (only AppleLossless/ALAC is supported)");
+        http_response_init(response, "RTSP/1.0", 403, "Forbidden");
+        return;
+    }
+    if (encrypted) {
+        logger_log(raop->logger, LOGGER_ERR,
+                   "ANNOUNCE requested RSA-encrypted audio, which this build cannot decrypt; "
+                   "turn audio encryption off on the sender");
+        http_response_init(response, "RTSP/1.0", 403, "Forbidden");
+        return;
+    }
+
+    conn->raop_announced = true;
+    logger_log(raop->logger, LOGGER_INFO, "ANNOUNCE accepted (unencrypted ALAC)");
 }
 
 static void
@@ -618,6 +667,68 @@ raop_handler_setup(raop_conn_t *conn,
         }
     }
 
+    /*
+     * RAOP (AirPlay 1) SETUP carries a text "Transport:" header and no binary
+     * plist; the AirPlay 2 flow always sends a plist. Handle the RAOP variant
+     * here before falling through to the plist parser.
+     */
+    const char *transport_header = http_request_get_header(request, "Transport");
+    if (transport_header && (!data || data_len < 8 || memcmp(data, "bplist00", 8) != 0)) {
+        unsigned short remote_cport = 0;
+        unsigned short cport = 0;
+        unsigned short dport = 0;
+        unsigned short timing_lport = 0;
+        /* RAOP senders (cliairplay/libraop, shairport-based tools) timestamp with
+         * plain Unix-epoch seconds: NTP would subtract 2208988800 and wreck the
+         * sync calculation. */
+        timing_protocol_t time_protocol = TP_NONE;
+        unsigned char ct = 2;          /* 2 = ALAC */
+        unsigned int sr = 44100;
+        char remote[40] = { 0 };
+        char transport_reply[256] = { 0 };
+        const char *cp = strstr(transport_header, "control_port=");
+        const char *tp = strstr(transport_header, "timing_port=");
+
+        if (!conn->raop_announced) {
+            logger_log(raop->logger, LOGGER_WARNING, "RAOP SETUP without a preceding ANNOUNCE");
+        }
+        if (cp) {
+            remote_cport = (unsigned short) atoi(cp + strlen("control_port="));
+        }
+        if (!utils_ipaddress_to_string(conn->remotelen, conn->remote, conn->zone_id,
+                                       remote, (int) sizeof(remote))) {
+            logger_log(raop->logger, LOGGER_ERR, "RAOP SETUP: cannot determine the client address");
+            http_response_init(response, "RTSP/1.0", 500, "Internal Server Error");
+            return;
+        }
+
+        if (!conn->raop_ntp) {
+            conn->raop_ntp = raop_ntp_init(raop->logger, &raop->callbacks, remote, conn->remotelen,
+                                           (unsigned short) (tp ? atoi(tp + strlen("timing_port=")) : 0),
+                                           &time_protocol);
+            raop_ntp_start(conn->raop_ntp, &timing_lport);
+        }
+        if (!conn->raop_rtp) {
+            /* unencrypted RAOP stream: no AES key/IV */
+            conn->raop_rtp = raop_rtp_init(raop->logger, &raop->callbacks, conn->raop_ntp,
+                                           remote, conn->remotelen, NULL, NULL);
+        }
+        if (!conn->raop_rtp) {
+            logger_log(raop->logger, LOGGER_ERR, "RAOP SETUP: could not initialise the RTP stream");
+            http_response_init(response, "RTSP/1.0", 500, "Internal Server Error");
+            return;
+        }
+        raop_rtp_start_audio(conn->raop_rtp, &remote_cport, &cport, &dport, &ct, &sr);
+
+        snprintf(transport_reply, sizeof(transport_reply),
+                 "RTP/AVP/UDP;unicast;mode=record;server_port=%u;control_port=%u;timing_port=%u",
+                 (unsigned) dport, (unsigned) cport, (unsigned) timing_lport);
+        http_response_add_header(response, "Transport", transport_reply);
+        http_response_add_header(response, "Session", "1");
+        logger_log(raop->logger, LOGGER_INFO, "RAOP SETUP accepted (%s)", transport_reply);
+        return;
+    }
+
     // Parsing bplist
     plist_t req_root_node = NULL;
     plist_from_bin(data, data_len, &req_root_node);
diff --git a/lib/raop_ntp.c b/lib/raop_ntp.c
index 7da009d..75d5944 100644
--- a/lib/raop_ntp.c
+++ b/lib/raop_ntp.c
@@ -248,24 +248,37 @@ raop_ntp_init_socket(raop_ntp_t *raop_ntp, int use_ipv6)
     return -1;
 }
 
+/*
+ * Drain whatever is queued on the timing socket. RAOP (AirPlay 1) senders poll
+ * the receiver for time on this socket, so every queued packet may be a timing
+ * request (type 0xd2) that must be answered with a 0xd3 reply carrying our
+ * clock and echoing the sender's transmit timestamp in ref_time. Anything that
+ * is not a request is stale and can be dropped.
+ */
 static void
-raop_ntp_flush_socket(int fd)
+raop_ntp_answer_requests(raop_ntp_t *raop_ntp)
 {
-#ifdef _WIN32
-    u_long bytes_available = 0;
-#else
-    int bytes_available = 0;
-#endif
-    while (IOCTLSOCKET(fd, FIONREAD, &bytes_available) == 0 && bytes_available > 0)
-    {
-        // We are guaranteed that we won't block, because bytes are available.
-        // Read 1 byte. Extra bytes in the datagram will be discarded.
-        char c;
-        int result = recvfrom(fd, &c, sizeof(c), 0, NULL, NULL);
-        if (result < 0)
-        {
+    unsigned char packet[128];
+    struct sockaddr_storage src_addr;
+    socklen_t src_len;
+
+    while (1) {
+        src_len = sizeof(src_addr);
+        int n = recvfrom(raop_ntp->tsock, (char *) packet, sizeof(packet), 0,
+                         (struct sockaddr *) &src_addr, &src_len);
+        if (n <= 0) {
             break;
         }
+        if ((packet[1] & ~0x80) != 0x52) {
+            continue;   /* not a timing request */
+        }
+        unsigned char reply[32] = { 0x80, 0xd3, 0x00, 0x07 };
+        uint64_t reply_time = raop_ntp_get_local_time();
+        memcpy(&reply[8], &packet[24], 8);
+        byteutils_put_ntp_timestamp(reply, 16, reply_time);
+        byteutils_put_ntp_timestamp(reply, 24, reply_time);
+        sendto(raop_ntp->tsock, (char *) reply, sizeof(reply), 0,
+               (struct sockaddr *) &src_addr, src_len);
     }
 }
 
