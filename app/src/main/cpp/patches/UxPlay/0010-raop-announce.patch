+  vctx->get_cb = cb;
+  vctx->get_cb_arg = cb_arg;
+  vctx->verify_client_signature = cb;
+
+  server_keypair(vctx->server_public_key, vctx->server_private_key, vctx->device_id);
+
+  return 0;
+}
