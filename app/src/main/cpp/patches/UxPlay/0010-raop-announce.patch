+/* Tell whether a body is an AirPlay 2 HAP (TLV8) pairing message rather than the
+ * legacy fixed-size pairing blob: it must parse as TLV and carry a State tag.
+ * (The pairing itself is handled by pair_ap, see pair_ap/.) */
+int hap_looks_like_pairing(const unsigned char *buf, int len)
+{
+    int i = 0, saw_state = 0;
+    if (!buf || len < 4 || len == 32) return 0;
+    while (i + 2 <= len) {
+        int t = buf[i];
+        int l = buf[i + 1];
+        if (i + 2 + l > len) return 0;      /* not well-formed TLV8 */
+        if (t == 0x06 && l == 1) saw_state = 1;
+        i += 2 + l;
+    }
+    return saw_state;
+}
