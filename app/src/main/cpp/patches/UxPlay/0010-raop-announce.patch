+/* ---------- AirPlay 2 (HAP) channel encryption ---------- */
+
+/* Append ciphertext to the connection's pending buffer. */
+static int
+connection_rx_append(http_connection_t *connection, const uint8_t *data, size_t len)
+{
+    if (connection->rx_len + len > connection->rx_cap) {
+        size_t cap = connection->rx_cap ? connection->rx_cap * 2 : 8192;
+        while (cap < connection->rx_len + len) cap *= 2;
+        uint8_t *n = realloc(connection->rx, cap);
+        if (!n) return -1;
+        connection->rx = n;
+        connection->rx_cap = cap;
+    }
+    memcpy(connection->rx + connection->rx_len, data, len);
+    connection->rx_len += len;
+    return 0;
+}
+
+/* Decrypt whatever complete blocks the pending buffer holds. Returns a malloc'd
+ * plaintext buffer (NULL when nothing complete yet) and how much was consumed. */
+static uint8_t *
+connection_rx_decrypt(http_connection_t *connection, size_t *plain_len_out, size_t *consumed_out)
+{
+    uint8_t *plain = NULL;
+    size_t plain_len = 0;
+    ssize_t consumed;
+
+    *plain_len_out = 0;
+    *consumed_out = 0;
+    if (!connection->cipher || connection->rx_len == 0) return NULL;
+
+    consumed = pair_decrypt(&plain, &plain_len, connection->rx, connection->rx_len, connection->cipher);
+    if (consumed <= 0) {
+        if (consumed < 0) return NULL;   /* incomplete block: wait for more bytes */
+        return NULL;
+    }
+    *plain_len_out = plain_len;
+    *consumed_out = (size_t) consumed;
+    return plain;
+}
+
