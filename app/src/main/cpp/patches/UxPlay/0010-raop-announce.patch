+
+/* ---------------------------------- SRP ----------------------------------- */
+
+typedef enum
+{
+  SRP_NG_2048,
+  SRP_NG_3072,
+  SRP_NG_CUSTOM
+} SRP_NGType;
+
+typedef struct
+{
+  int N_len;
+  bnum N;
+  bnum g;
+} NGConstant;
+
+struct SRPUser
+{
