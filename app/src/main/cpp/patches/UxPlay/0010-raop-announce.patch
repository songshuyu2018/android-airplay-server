+    if (!(key = EVP_PKEY_Q_keygen(NULL, NULL, "X25519"))) return -1;
+    if (EVP_PKEY_get_raw_private_key(key, sk, &len) != 1 || len != 32) goto out;
+    len = 32;
+    if (EVP_PKEY_get_raw_public_key(key, pk, &len) != 1 || len != 32) goto out;
+    ok = 0;
+out:
+    EVP_PKEY_free(key);
+    return ok;
+}
+
+static int x25519_derive(unsigned char *out, const unsigned char *sk, const unsigned char *peer_pk)
+{
+    EVP_PKEY *key = NULL, *peer = NULL, *ctx_key = NULL;
+    EVP_PKEY_CTX *ctx = NULL;
+    size_t len = 32;
+    int ok = -1;
+
+    key = EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, NULL, sk, 32);
+    peer = EVP_PKEY_new_raw_public_key(EVP_PKEY_X25519, NULL, peer_pk, 32);
+    if (!key || !peer || !(ctx = EVP_PKEY_CTX_new(key, NULL))) goto out;
+    if (EVP_PKEY_derive_init(ctx) != 1 || EVP_PKEY_derive_set_peer(ctx, peer) != 1) goto out;
+    if (EVP_PKEY_derive(ctx, out, &len) != 1 || len != 32) goto out;
+    ok = 0;
+out:
+    EVP_PKEY_CTX_free(ctx);
+    EVP_PKEY_free(peer);
+    EVP_PKEY_free(key);
+    EVP_PKEY_free(ctx_key);
+    return ok;
+}
+
+int crypto_scalarmult(unsigned char *q, const unsigned char *n, const unsigned char *p)
+{
+    return x25519_derive(q, n, p);
+}
+
+int crypto_scalarmult_base(unsigned char *q, const unsigned char *n)
+{
+    EVP_PKEY *key = NULL;
+    size_t len = 32;
+    int ok = -1;
+
+    key = EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, NULL, n, 32);
+    if (!key) return -1;
+    if (EVP_PKEY_get_raw_public_key(key, q, &len) == 1 && len == 32) ok = 0;
+    EVP_PKEY_free(key);
+    return ok;
+}
